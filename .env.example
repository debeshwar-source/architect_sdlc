# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Jira Cloud: base URL + the email of the account that owns the API token.
# Jira Data Center: leave JIRA_EMAIL empty and use a personal access token.
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ARCH

# Confluence (optional): publish the Design agent's document with its diagrams.
# Uses the same site, email and token as Jira above; you only need to name the space.
CONFLUENCE_SPACE_KEY=ENG
# CONFLUENCE_PARENT_PAGE_ID=      # optional: create the page under this page
# CONFLUENCE_BASE_URL=            # only if Confluence is on a different site than Jira
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
